<Window x:Class="Duplicate_Files_Cleaner.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Duplicate_Files_Cleaner"
        mc:Ignorable="d"
        Title="SETTINGS" Height="480" Width="400" MinWidth="400" MinHeight="448" MaxWidth="400" MaxHeight="8450" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="header_textblock" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI Light"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FF646464"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle>
            <Rectangle.BitmapEffect>
                <BlurBitmapEffect Radius="30"/>
            </Rectangle.BitmapEffect>
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="SkyBlue"/>
                    <GradientStop Color="White" Offset="0.12"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock FontFamily="Segoe UI Light" Margin="10,10" HorizontalAlignment="Left" FontSize="24" TextWrapping="Wrap" Text="Duplicate Files Cleaner Settings" VerticalAlignment="Top"/>
        <ScrollViewer Margin="0,50">
            <StackPanel>

                <Grid Margin="10,0" VerticalAlignment="Top">
                    <TextBlock Text="General" Style="{StaticResource header_textblock}"/>
                    <ComboBox x:Name="language" HorizontalAlignment="Left" SelectedIndex="1" Width="157" Margin="89,28,0,0" Height="22" VerticalAlignment="Top">
                        <ComboBoxItem Content="Arabic (العربية)" IsEnabled="False"/>
                        <ComboBoxItem Content="English (English)"/>
                    </ComboBox>
                    <TextBlock HorizontalAlignment="Left" Margin="10,31,0,0" TextWrapping="Wrap" Text="Language" VerticalAlignment="Top"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,60,0,0" TextWrapping="Wrap" Text="Buffer size" VerticalAlignment="Top"/>
                    <Slider x:Name="buffer_slider" Margin="47,82,85,0" VerticalAlignment="Top" Minimum="1" Maximum="16" Value="0" SmallChange="1" LargeChange="1" TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" ValueChanged="BufferSlider_ValueChanged"/>
                    <TextBlock x:Name="buffer_textblock" HorizontalAlignment="Right" Margin="0,82,5,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="70" TextAlignment="Center"/>

                </Grid>

                <StackPanel Margin="10" VerticalAlignment="Top">
                    <TextBlock Text="File exploring setting" Margin="0,10,0,0" Style="{StaticResource header_textblock}"/>
                    <CheckBox x:Name="system_files" Content="Exclude 'System' files." HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" IsChecked="True"/>
                    <CheckBox x:Name="hidden_files" Content="Exclude 'Hidden' files." HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top" IsChecked="True"/>
                    <CheckBox x:Name="skip_generated" Content="Skip project and generated folders" HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top" IsChecked="True"/>
                    <TextBlock Margin="28,2,10,0" TextWrapping="Wrap" Foreground="#FF404040" Text="Folders with these names, and the folder a browser saves next to a web page (page_files). Separate the names with ;"/>
                    <TextBox x:Name="generated_folders_list" Margin="28,4,10,0" TextWrapping="Wrap" FontSize="12" Background="Transparent" BorderBrush="Gray" BorderThickness="0,1" IsEnabled="{Binding ElementName=skip_generated, Path=IsChecked}"/>
                    <CheckBox x:Name="special_folder" Content="Exclude these Folders" HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top" IsChecked="True"/>
                    <Grid Margin="15,5,10,0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="special_folder_list" MaxHeight="300" Text="C:\Windows&#xD;&#xA;C:\Program Files&#xA;C:\Program Files (x86)&#xA;C:\ProgramData&#xA;C:\Users\DrMoh\AppData" Margin="0,5,75,0" VerticalAlignment="Top" FontSize="12" Background="Transparent" BorderBrush="Gray" BorderThickness="0,1" Grid.RowSpan="3" AcceptsReturn="True" MaxLines="20" VerticalScrollBarVisibility="Auto"/>
                        <Button Content="Browse" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="60" Background="Transparent" Click="Browse_Click" Height="20" Margin="0,0,10,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="10" VerticalAlignment="Top">
                    <TextBlock Margin="0,10,0,10" Text="Scan mode" Style="{StaticResource header_textblock}"/>
                    <RadioButton x:Name="do_full_scan" Margin="10,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF737575" IsChecked="True">
                        <TextBlock><Run Text="Exact ("/><Run Foreground="Green" Text="recommended"/><Run Text=")"/></TextBlock>
                    </RadioButton>
                    <TextBlock Margin="28,2,10,0" TextWrapping="Wrap" Foreground="#FF404040" VerticalAlignment="Top"
                               Text="Compares the files byte by byte. Files are called duplicates only when every byte is the same. Each file is read once, and reading stops as soon as files differ."/>
                    <RadioButton x:Name="smart_scan" Margin="10,12,0,0" Content="Fingerprint (SHA-512)" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#FF737575"/>
                    <TextBlock Margin="28,2,10,0" TextWrapping="Wrap" Foreground="#FF404040" VerticalAlignment="Top"
                               Text="Compares a SHA-512 fingerprint of each whole file. Two different files getting the same fingerprint is practically impossible. Reads every byte of every candidate, so it is usually not faster than Exact."/>
                    <RadioButton x:Name="fast_scan" Margin="10,12,10,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock><Run Text="Quick preview ("/><Run Foreground="Tomato" Text="not confirmed"/><Run Text=")"/></TextBlock>
                    </RadioButton>
                    <TextBlock Margin="28,2,10,0" TextWrapping="Wrap" Foreground="#FF404040" VerticalAlignment="Top"
                               Text="Compares the size and a few bytes from each file. Different files can look the same, for example an edited document or a photo with changed details. The results must be confirmed by an exact check before deleting."/>
                    <RadioButton x:Name="file_size_scan" Margin="10,12,10,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock><Run Text="Size preview ("/><Run Foreground="Tomato" Text="not confirmed"/><Run Text=")"/></TextBlock>
                    </RadioButton>
                    <TextBlock Margin="28,2,10,5" TextWrapping="Wrap" Foreground="#FF404040" VerticalAlignment="Top"
                               Text="Compares the sizes only. Many different files have the same size, so this only shows where duplicates may be. The results must be confirmed before deleting."/>
                </StackPanel>

                <StackPanel Margin="10" VerticalAlignment="Top">
                    <TextBlock Margin="0,0,0,5" Text="Copy to keep" Style="{StaticResource header_textblock}"/>
                    <TextBlock Margin="10,0,10,5" TextWrapping="Wrap" Foreground="#FF404040" Text="When selecting duplicates, one copy in each group is kept. The rules decide which one, from top to bottom: a rule only counts when the rules above it are equal."/>
                    <ListBox Margin="20,5,75,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" BorderBrush="RoyalBlue" BorderThickness="0,2">
                        <CheckBox x:Name="name_contains" Margin="5" IsChecked="True">
                            <DockPanel Width="225">
                                <TextBlock DockPanel.Dock="Left" Text="Name doesn't contain:" Height="15"/>
                                <TextBox x:Name="name_contains_list" Margin="10,0" HorizontalAlignment="Right" DockPanel.Dock="Right" Width="70" Text="@#$%^{}">
                                </TextBox>
                            </DockPanel>
                        </CheckBox>
                        <CheckBox x:Name="file_name" Margin="5" IsChecked="True">
                            <DockPanel Width="225">
                                <TextBlock DockPanel.Dock="Left" Text="File name:" Height="15"/>
                                <ComboBox x:Name="file_name_combo" Margin="10,0" HorizontalAlignment="Right" DockPanel.Dock="Right" SelectedIndex="0" Width="70">
                                    <ComboBoxItem Content="Longest"/>
                                    <ComboBoxItem Content="Shortest"/>
                                </ComboBox>
                            </DockPanel>
                        </CheckBox>
                        <CheckBox  x:Name="file_path" Margin="5" IsChecked="True">
                            <DockPanel Width="225">
                                <TextBlock DockPanel.Dock="Left" Text="File path:" Height="15"/>
                                <ComboBox x:Name="file_path_combo" Margin="10,0" HorizontalAlignment="Right" DockPanel.Dock="Right" SelectedIndex="1" Width="70">
                                    <ComboBoxItem Content="Longest"/>
                                    <ComboBoxItem Content="Shortest"/>
                                </ComboBox>
                            </DockPanel>
                        </CheckBox>
                        <CheckBox x:Name="creating_date" Margin="5" IsChecked="True">
                            <DockPanel Width="225">
                                <TextBlock DockPanel.Dock="Left" Text="Created date:" Height="15"/>
                                <ComboBox x:Name="creating_date_combo" Margin="10,0" HorizontalAlignment="Right" DockPanel.Dock="Right" SelectedIndex="0" Width="70">
                                    <ComboBoxItem Content="Newest"/>
                                    <ComboBoxItem Content="Oldest"/>
                                </ComboBox>
                            </DockPanel>
                        </CheckBox>
                        <CheckBox x:Name="modified_date" Margin="5" IsChecked="True">
                            <DockPanel Width="225">
                                <TextBlock DockPanel.Dock="Left" Text="Modified date:" Height="15"/>
                                <ComboBox x:Name="modified_date_combo" Margin="10,0" HorizontalAlignment="Right" DockPanel.Dock="Right" SelectedIndex="0" Width="70">
                                    <ComboBoxItem Content="Newest"/>
                                    <ComboBoxItem Content="Oldest"/>
                                </ComboBox>
                            </DockPanel>
                        </CheckBox>
                    </ListBox>
                </StackPanel>

                <StackPanel Margin="10" VerticalAlignment="Top">
                    <TextBlock Margin="0,0,0,10" Text="When deleting" Style="{StaticResource header_textblock}"/>
                    <RadioButton x:Name="recycle_option" Margin="10,0,0,0" Content="Move files to the Recycle Bin (recommended)" IsChecked="True"/>
                    <TextBlock Margin="28,2,10,0" TextWrapping="Wrap" Foreground="#FF404040" Text="You can restore them later. Files on USB and network drives are skipped, because those drives have no Recycle Bin."/>
                    <RadioButton x:Name="permanent_option" Margin="10,10,0,0" Content="Delete files permanently"/>
                    <TextBlock Margin="28,2,10,0" TextWrapping="Wrap" Foreground="#FF404040" Text="Frees the space right away, but the files can't be restored."/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Height="50" VerticalAlignment="Bottom" Background="#FFEBEBEB">
            <Button Content="Default" DockPanel.Dock="Left" HorizontalAlignment="Right" Margin="10,10,10,10" Width="80" Background="Transparent" BorderBrush="Green" Foreground="Green" FontFamily="Segoe UI" FontSize="14" BorderThickness="2,1" Click="DefaultButton_Click"/>
            <Button Content="OK" IsDefault="True" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,10,10,10" Width="80" Background="Transparent" BorderBrush="RoyalBlue" Foreground="RoyalBlue" FontFamily="Segoe UI" FontSize="14" BorderThickness="2,1" Click="SaveButton_Click"/>
            <Button Content="Cancel" IsCancel="True" DockPanel.Dock="Right"  HorizontalAlignment="Right" Margin="0,10,10,10" Width="80" Background="Transparent" BorderBrush="Tomato" Foreground="Tomato" FontFamily="Segoe UI" FontSize="14" BorderThickness="2,1" Click="Cancel_Click"/>
        </DockPanel>
    </Grid>
</Window>