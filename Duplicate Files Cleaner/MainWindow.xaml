<Window x:Class="Duplicate_Files_Cleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Duplicate_Files_Cleaner"
        mc:Ignorable="d"
        Title="Duplicate Files Cleaner" Height="425" Width="600" Closing="Window_Closing" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding ElementName=progressbar, Path=Value,Mode=OneWay}" ProgressState="Normal"/>
    </Window.TaskbarItemInfo>
    <Grid>
        <Grid x:Name="main_grid">
            <Grid.BitmapEffect>
                <BlurBitmapEffect x:Name="blur" Radius="1"/>
            </Grid.BitmapEffect>
            <Grid Background="Black" Margin="0,0,0,0" Height="36" VerticalAlignment="Top"></Grid>
            <StackPanel x:Name="tab_panal" Height="36" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
                <Label x:Name="label1" Content="FIND DUPLICATES" FontSize="18" Background="White" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
                <Label x:Name="label2" Content="IS SIMILAR TO" FontSize="18" Foreground="White" Background="Black" Cursor="Hand" PreviewMouseLeftButtonUp="TabChange_MouseButtonUp"/>
            </StackPanel>

            <Grid x:Name="mother" Margin="0,0,0,0">
                <Grid Margin="0,0,0,0" HorizontalAlignment="Left" Width="595">
                    <Button x:Name="find_duplicate" Margin="10,42,0,0" ToolTip="Choose folders to search in" VerticalAlignment="Top" Click="FindDuplicate_Click" Background="{x:Null}" HorizontalAlignment="Left" Height="32" Width="32">
                        <Image Source="Assets/Icons/folder-search.png" Width="26" Height="26" Stretch="Fill"/>
                    </Button>
                    <DockPanel x:Name="tool_dock" Visibility="Collapsed" Margin="0,41,49,0" HorizontalAlignment="Right" Width="202" Height="33" VerticalAlignment="Top">
                        <Button x:Name="clear_list" Margin="2,0" DockPanel.Dock="Right"  ToolTip="Clear list" VerticalAlignment="Top" Click="ClearList_Click" HorizontalAlignment="Right" Background="{x:Null}" Height="32" Width="32">
                            <Image Source="Assets/Icons/list-clear.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button>
                        <Button x:Name="delete" Margin="2,0" DockPanel.Dock="Right"  ToolTip="Delete selected items" VerticalAlignment="Top" Click="Delete_Click" Background="{x:Null}" HorizontalAlignment="Right" Height="32" Width="32">
                            <Image Source="Assets/Icons/delete.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button>
                        <Button x:Name="select_none" Margin="2,0" DockPanel.Dock="Right"  ToolTip="Select none" VerticalAlignment="Top" Click="SelectNone_Click" Background="{x:Null}" HorizontalAlignment="Right" Height="32" Width="32">
                            <Image Source="Assets/Icons/select-none.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button>
                        <Button x:Name="select_all" Margin="2,0" DockPanel.Dock="Right" ToolTip="Select all" VerticalAlignment="Top" Click="SelectAll_Click" Background="{x:Null}" HorizontalAlignment="Right" Height="32" Width="32">
                            <Image Source="Assets/Icons/select-all.png" Width="28" Height="28" Stretch="UniformToFill"/>
                        </Button>
                        <Button x:Name="sort_button" Margin="2,0" DockPanel.Dock="Right" ToolTip="Sort" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Click="SortBy_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="sort_by_contextmenu">
                                    <MenuItem x:Name="by_count_main_menu" Header="by duplicates count" IsCheckable="True" IsChecked="True" Click="SortLists_Click"/>
                                    <MenuItem x:Name="by_size_main_menu" Header="by single file size" IsCheckable="True" IsChecked="False" Click="SortLists_Click"/>
                                    <MenuItem x:Name="by_total_size_main_menu" Header="by total files size" IsCheckable="True" IsChecked="False" Click="SortLists_Click"/>
                                    <MenuItem x:Name="by_type_main_menu" Header="by type" IsCheckable="True" IsChecked="False" Click="SortLists_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="ascrending_menu_item" Header="Ascending" IsCheckable="True" IsChecked="True" Click="SortLists_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Image Source="Assets/Icons/sort-by.png" Height="28" Width="28" Stretch="UniformToFill"/>
                        </Button>
                    </DockPanel>
                    <Button x:Name="log" ToolTip="Save Log" Margin="0,41,15,0" VerticalAlignment="Top" IsEnabled="False" HorizontalAlignment="Right" Background="{x:Null}" Height="32" Width="32" Click="SaveLog_Click">
                        <Image Source="Assets/Icons/log.png" Height="28" Width="28" Stretch="Fill"/>
                    </Button>

                    <TextBlock HorizontalAlignment="Left" Margin="10,0,0,7" VerticalAlignment="Bottom" FontSize="16" TextTrimming="CharacterEllipsis">
                    <Run Foreground="Goldenrod" Text="{Binding ElementName=item_group_viewer, Path=Items.Count, Mode=OneWay}"/>
                    <Run Foreground="DarkSlateBlue">
                        <Run.Style>
                            <Style TargetType="Run">
                                <Setter Property="Text" Value="items"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MyList.Count}" Value="1">
                                        <Setter Property="Text" Value="item"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>
                    </Run>
                    </TextBlock>

                    <Grid x:Name="flow_shart" Visibility="Hidden" HorizontalAlignment="Left" Height="25" Margin="112,0,0,3" VerticalAlignment="Bottom" Width="322">
                        <Rectangle x:Name="total" Height="21" Margin="2,2,2,2" Stroke="RoyalBlue" VerticalAlignment="Bottom">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                    <GradientStop Color="SkyBlue" Offset="1"/>
                                    <GradientStop Color="#FF6EAAE7" Offset="0.669"/>
                                    <GradientStop Color="#FF659DE5"/>
                                    <GradientStop Color="#FF68A2E5" Offset="0.334"/>
                                    <GradientStop Color="#FF7CBEE9" Offset="0.801"/>
                                    <GradientStop Color="#FF669FE5" Offset="0.195"/>
                                    <GradientStop Color="#FE6AA5E5" Offset="0.467"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="duplicate" Height="19" Margin="3,0,0,3" Stroke="Black" VerticalAlignment="Bottom" StrokeThickness="0" HorizontalAlignment="Left" Width="254">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FFD485D4"/>
                                    <GradientStop Color="#FFFF9AFA" Offset="1"/>
                                    <GradientStop Color="#FFED91EA" Offset="0.599"/>
                                    <GradientStop Color="#FFF293EE" Offset="0.712"/>
                                    <GradientStop Color="#FFE38CE1" Offset="0.377"/>
                                    <GradientStop Color="#FFDB88DA" Offset="0.195"/>
                                    <GradientStop Color="#FFE68DE3" Offset="0.444"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid x:Name="deleted_grid" HorizontalAlignment="Left" Height="25" Margin="0,0,0,0" VerticalAlignment="Top" Width="170">
                            <Rectangle x:Name="deleted_rect" Height="25" Margin="0,0,0,0" Stroke="Red" VerticalAlignment="Top" StrokeThickness="3" Fill="#54FF6347"/>
                            <TextBlock x:Name="deleted_text" Margin="4,3,4,0" Text="" VerticalAlignment="Top" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="White"/>
                        </Grid>
                    </Grid>

                    <Grid Margin="10,79,15,33">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="200"/>
                            <ColumnDefinition MinWidth="200" Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="item_viewer" Margin="11,0,0,0" ItemsSource="{Binding}" Grid.Column="1">
                            <ListView.Resources>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <EventSetter Event='Control.MouseDoubleClick' Handler='Item_MouseDoubleClick'/>
                                    <EventSetter Event='UIElement.PreviewKeyUp'  Handler='Item_PreviewKeyUp'/>
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock Margin="44,4,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left"/>
                                        <Image Margin="16,0,0,0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        <CheckBox Margin="0" IsChecked="{Binding IsChecked}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Sun_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <GridSplitter HorizontalAlignment="Left" Background="#FF919191" Width="5" Grid.Column="1" Margin="1,0,0,0"/>
                        <ListView x:Name="item_group_viewer" Margin="0,0,4,0" ItemsSource="{Binding}" SelectionChanged="ItemGroupViewer_SelectionChanged" MinWidth="200">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Group" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <CheckBox Margin="0" IsChecked="{Binding IsChecked, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Group_Click"/>
                                                    <Image Margin="2,0,0,0" Source="{Binding Image}" Height="24" Width="24" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                                    <TextBlock Margin="4,2,0,0" Text="{Binding FullPath}" HorizontalAlignment="Left" FontSize="14"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding FileType}"/>
                                    <GridViewColumn Header="File Size" Width="60" DisplayMemberBinding="{Binding FileSize}"/>
                                    <GridViewColumn Header="Total Size" Width="75" DisplayMemberBinding="{Binding TotalFileSize}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>

                <Grid Margin="600,0,0,0" HorizontalAlignment="Left" Width="595">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="compare" HorizontalAlignment="Right" Margin="0,0,15,10" VerticalAlignment="Bottom" Width="107" Height="35" Grid.Column="1" FontSize="16" Click="Compare_Click">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop x:Name="go_button_color" Color="Tomato" Offset="0"/>
                                <GradientStop Color="White" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Grid x:Name="f_grid" Margin="10,50,0,125" Background="#00000000" Drop="Grid_Drop" AllowDrop="True">
                        <TextBox x:Name="f_filepath" Margin="101,34,10,0" TextWrapping="Wrap" Text="-" VerticalAlignment="Top" FontSize="14" MaxHeight="96" BorderBrush="{x:Null}" TextChanged="FirstFilePath_TextChanged"/>
                        <TextBlock x:Name="f_filename" TextTrimming="CharacterEllipsis" Text="First file" VerticalAlignment="Top" FontSize="16" Foreground="#FF003397" FontWeight="Bold" Margin="0,3,43,0"/>
                        <Image x:Name="f_image" HorizontalAlignment="Left" Height="96" Margin="0,34,0,0" VerticalAlignment="Top" Width="96" Source="Assets/Icons/warning-grey.png"/>
                        <TextBlock x:Name="f_type" Margin="10,135,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                        <TextBlock x:Name="f_size" Margin="10,159,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                        <TextBlock x:Name="f_date" HorizontalAlignment="Left" Margin="10,183,0,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top" Width="268"/>
                        <Button x:Name="f_browse" ToolTip="Select first file" Content="B" Margin="0,0,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Height="28" Width="28" Background="{x:Null}" Click="Browse_Click"/>
                        <Rectangle HorizontalAlignment="Right" Margin="0,0,-2,10" Width="3">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="White" Offset="1"/>
                                    <GradientStop Color="#FFBCEDFF"/>
                                    <GradientStop Color="#FFCDF1FF" Offset="0.643"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <Grid x:Name="s_grid" Margin="10,50,10,125" Grid.Column="1" Background="#00000000" Drop="Grid_Drop" AllowDrop="True">
                        <TextBox x:Name="s_filepath" Margin="101,34,10,0" TextWrapping="Wrap" Text="-" VerticalAlignment="Top" FontSize="14" MaxHeight="96" BorderBrush="{x:Null}" TextChanged="SecondFilePath_TextChanged"/>
                        <TextBlock x:Name="s_filename" TextTrimming="CharacterEllipsis" Text="Second file" VerticalAlignment="Top" FontSize="16" Foreground="#FF003397" FontWeight="Bold" Margin="0,3,43,0"/>
                        <Image x:Name="s_image" HorizontalAlignment="Left" Height="96" Margin="0,34,0,0" VerticalAlignment="Top" Width="96" Source="Assets/Icons/warning-grey.png"/>
                        <TextBlock x:Name="s_type" Margin="10,135,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                        <TextBlock x:Name="s_size" Margin="10,159,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                        <TextBlock x:Name="s_date" Margin="10,183,10,0" TextTrimming="CharacterEllipsis" Text="-" FontSize="14" VerticalAlignment="Top"/>
                        <Button ToolTip="Select first file" Content="B" Margin="0,0,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Height="28" Width="28" Background="{x:Null}" Click="Browse_Click"/>
                    </Grid>
                    <TextBlock HorizontalAlignment="Left" Margin="10,0,0,5" TextWrapping="Wrap" Text="You can drag and drop files or folders." VerticalAlignment="Bottom" TextDecorations="Underline" Foreground="#FF404040"/>

                </Grid>
            </Grid>
            <Rectangle x:Name="rec" Fill="ForestGreen" HorizontalAlignment="Left" Height="4" Margin="0,32,0,0" VerticalAlignment="Top" Width="142"/>
            <Button ToolTip="About Duplicate Files Cleaner" HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Background="{x:Null}" BorderBrush="{x:Null}" Click="AboutTool_Click">
                <Image Stretch="Fill"  Height="28" Width="28"  Source="Assets/Icons/about.png"/>
            </Button>
            <Button ToolTip="Setting" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{x:Null}" Height="36" Width="36" Click="Setting_Click" Margin="0,0,36,0" BorderThickness="0">
                <Image Source="Assets/Icons/settings.png" Height="28" Width="28" Stretch="Fill"/>
            </Button>
        </Grid>
        <Grid x:Name="progress_grid" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#34303030" Offset="0"/>
                    <GradientStop Color="#33EBEBEB" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Rectangle Height="180" Grid.Column="1" Grid.Row="1">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#E5646464" Offset="0.5"/>
                        <GradientStop Color="#E59B9B9B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Grid.Column="1" Grid.Row="1">
                <Image Source="Assets/Icons/progress_icon.png" Width="28" Height="28" HorizontalAlignment="Left" Margin="2,1,0,0" VerticalAlignment="Top" Stretch="Fill"/>
                <TextBlock Foreground="WhiteSmoke" FontSize="18" Margin="35,2,9,0" Text="Working..." Height="25" VerticalAlignment="Top"/>
                <Rectangle Height="2" Margin="0,30,0,0" VerticalAlignment="Top" Fill="White"/>

                <TextBlock x:Name="progress_text" Margin="10,36,10,0" Text="0%" FontSize="48" VerticalAlignment="Top" Foreground="White" TextAlignment="Center"/>
                <TextBlock x:Name="current_action" Margin="10,109,135,0" Text="Preparing..." FontSize="16" VerticalAlignment="Top" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="progressbar" Maximum="1" Visibility="Visible" Height="7" VerticalAlignment="Top" Margin="10,136,135,0" Foreground="RoyalBlue"/>
                <Button ToolTip="Pause" Content="Pause" IsEnabled="False" HorizontalAlignment="Right" Margin="0,120,79,0" VerticalAlignment="Top" Width="30" Height="26" Background="Transparent" Foreground="White" BorderBrush="White" Padding="1" BorderThickness="2,1" FontSize="14"/>
                <Button ToolTip="Cancel" Content="Cancel" HorizontalAlignment="Right" Margin="0,120,44,0" VerticalAlignment="Top" Width="30" Height="26" Background="Transparent" Foreground="White" BorderBrush="White" Padding="1" BorderThickness="2,1" FontSize="14" Click="CancelOperation_Click"/>
            </Grid>
        </Grid>
    </Grid>

</Window>
